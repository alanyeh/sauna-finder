# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Supabase project — Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps BROWSER key. In the Google Cloud Console restrict it to:
#   - Application restrictions: HTTP referrers (your domains + http://localhost:*)
#   - API restrictions: Maps JavaScript API + Geocoding API
VITE_GOOGLE_MAPS_API_KEY=

# NOTE: the Google PLACES API key is intentionally NOT here. It must never reach
# the browser — it lives only as the GOOGLE_PLACES_API_KEY secret on the
# `places-proxy` Supabase Edge Function (set via `supabase secrets set`).
